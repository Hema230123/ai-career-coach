# =============================================================================
# AI Career Coach — Environment Variables Template
# =============================================================================
#
# WHAT IS THIS FILE?
# This is a template showing all the environment variables the app needs.
# It is SAFE TO COMMIT to git because it contains no real secrets — only
# placeholder values and explanations.
#
# HOW TO USE IT:
# 1. Copy this file to `.env.local`  (run: cp .env.example .env.local)
# 2. Fill in your real values in `.env.local`
# 3. NEVER commit `.env.local` — it's listed in .gitignore
#
# WHAT ARE ENVIRONMENT VARIABLES?
# They are key=value pairs that live OUTSIDE your code. This means:
# - Your API keys and passwords don't end up on GitHub
# - You can use different values for development vs production
#   (e.g., a test database locally, a real database in production)
# =============================================================================


# --- DATABASE ---
# Your PostgreSQL connection string.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
#
# For local development, install PostgreSQL and create a database:
#   createdb ai_career_coach
# Then your URL will look like:
#   postgresql://postgres:yourpassword@localhost:5432/ai_career_coach
DATABASE_URL="postgresql://username:password@localhost:5432/ai_career_coach"


# --- NEXTAUTH ---
# NEXTAUTH_SECRET: A random string used to encrypt session tokens (JWTs).
# Think of it as the "master password" for your session system.
#
# Generate a secure one with this command:
#   openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
#
# IMPORTANT: Use a different secret in production than in development.
NEXTAUTH_SECRET="replace-this-with-output-of-openssl-rand-base64-32"

# NEXTAUTH_URL: The full URL where your app is running.
# In development: always http://localhost:3000
# In production: your deployed URL (e.g., https://myapp.vercel.app)
NEXTAUTH_URL="http://localhost:3000"


# --- OPENAI ---
# Your OpenAI API key. This is what allows the app to call GPT-4o-mini.
#
# Get one at: https://platform.openai.com/api-keys
# It looks like: sk-proj-...
#
# SECURITY WARNING: Anyone with this key can use your OpenAI credits.
# Never share it, never commit it, never put it in client-side code.
OPENAI_API_KEY="sk-replace-with-your-real-openai-api-key"
